{
  "name": "fqgate-remote-bridge",
  "version": "0.1.0",
  "description": "Local-first Windows lifecycle manager for FQGate",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.23.0",
  "bin": {
    "fqgate-remote-bridge": "dist/cli/main.js"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 17282",
    "build": "pnpm build:cli && pnpm build:bridge",
    "build:cli": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "build:bridge": "pnpm route:generate && vite build",
    "route:generate": "tsr generate",
    "start": "node scripts/start-bridge.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 17282",
    "typecheck": "pnpm route:generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.0",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-start": "1.168.54",
    "jose": "6.2.12",
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.36",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9.35.0",
    "jsdom": "30.0.1",
    "nitro": "3.0.260903-beta",
    "prettier": "^3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "8.3.0",
    "vitest": "^3.2.4"
  }
}
